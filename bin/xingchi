#!/bin/sh
# Show the Xingchi Codex setup, or run a deeper check with --doctor.
set -u
UPSTREAM=https://api.xingchiapi.com/v1
KEY_FILE=${XINGCHI_HOME:-$HOME/.xingchi}/upstream.key
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}
SHARED_SKILLS=$HOME/.agents/skills

usage() {
  cat <<EOF
usage: xingchi [--doctor]

  (no args)   show API, model, key and codex status
  --doctor    run 'codex doctor' and report model/provider status
EOF
}

status() {
  printf '%s\n' "API:   $UPSTREAM (direct)"
  printf '%s\n' "models and reasoning: use /model in Codex"
  printf '%s\n' "catalogs: $CODEX_DIR/xingchi-models.json (GPT公益), $CODEX_DIR/xingchi-models-astra.json (Astra)"

  if [ -s "$KEY_FILE" ]; then
    printf '%-9s set (%s)\n' "Sol key" "$KEY_FILE"
  else
    printf '%-9s missing (%s)\n' "Sol key" "$KEY_FILE"
  fi

  ASTRA_KEY_FILE=${XINGCHI_HOME:-$HOME/.xingchi}/astra.key
  if [ -s "$ASTRA_KEY_FILE" ]; then
    printf '%-9s set (%s)\n' "Astra key" "$ASTRA_KEY_FILE"
  else
    printf '%-9s missing (%s)\n' "Astra key" "$ASTRA_KEY_FILE"
  fi

  if [ -d "$SHARED_SKILLS" ]; then
    printf '%-9s %s\n' "skills" "$SHARED_SKILLS (unified)"
  else
    printf '%-9s missing (%s)\n' "skills" "$SHARED_SKILLS"
  fi
  CONFLICT_FILE=${XINGCHI_HOME:-$HOME/.xingchi}/skill-conflicts.json
  if [ -f "$CONFLICT_FILE" ]; then
    printf '%-9s %s\n' "conflicts" "$CONFLICT_FILE"
  fi

  if command -v codex >/dev/null 2>&1; then
    printf '%-9s installed (%s)\n' "codex" "$(codex --version 2>/dev/null | head -n 1)"
  else
    printf '%-9s missing\n' "codex"
  fi

  printf '\nstart with: xingchi-codex\n'
  printf 'Astra key:  xingchi-codex --astra\n'
  printf 'Sol model:  xingchi-codex -m gpt-6.1-sol\n'
  printf 'Astra model: xingchi-codex --astra -m gpt-6-astra\n'
  printf 'deeper check: xingchi --doctor\n'
}

doctor() {
  if ! command -v codex >/dev/null 2>&1; then
    echo "error: codex not found. Run: npm install -g @openai/codex" >&2
    exit 1
  fi
  out=$(codex doctor 2>&1)
  rc=$?
  relevant=$(printf '%s\n' "$out" | grep -iE '(model|provider|inference URL|app-server)')
  if [ -n "$relevant" ]; then
    printf '%s\n' "$relevant"
  else
    printf '%s\n' "$out"
  fi
  printf '\ncodex doctor: '
  if [ "$rc" -eq 0 ]; then
    echo "healthy"
  else
    echo "reported problems (exit $rc)"
  fi
  return "$rc"
}

case "${1:-}" in
  "") status ;;
  --doctor) shift; doctor ;;
  -h|--help) usage ;;
  *)
    echo "error: unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
esac
