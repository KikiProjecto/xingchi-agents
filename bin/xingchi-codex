#!/bin/sh
# Xingchi Codex launcher.
# The Python runner keeps key handling identical on POSIX and Windows. It lives
# beside this launcher after installation.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || {
  echo "error: could not locate the Xingchi launcher" >&2
  exit 1
}
RUNNER="$SCRIPT_DIR/xingchi-codex-runner.py"
if [ ! -f "$RUNNER" ]; then
  echo "error: Xingchi runner missing at $RUNNER; rerun the installer" >&2
  exit 1
fi

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "error: Python 3 is required by the Xingchi launcher" >&2
  exit 1
fi

exec "$PYTHON" "$RUNNER" "$@"
